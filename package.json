{
  "name": "zero-setup-ai-mock-api-server",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered platform that turns natural-language descriptions into validated, testable mock REST APIs.",
  "license": "MIT",
  "workspaces": ["apps/server"],
  "scripts": {
    "dev": "npm run dev --workspace apps/server",
    "build": "npm run build --workspace apps/server",
    "start": "npm run start --workspace apps/server",
    "typecheck": "npm run typecheck --workspace apps/server",
    "test": "npm run test --workspace apps/server",
    "test:unit": "npm run test:unit --workspace apps/server",
    "test:integration": "npm run test:integration --workspace apps/server",
    "e2e": "python3 e2e/dashboard.e2e.py"
  },
  "engines": { "node": ">=20" }
}
