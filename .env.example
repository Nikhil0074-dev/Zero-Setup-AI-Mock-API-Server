# All values are optional. With none set the server runs locally with in-memory storage and the offline generator.
PORT=4000
HOST=127.0.0.1

# Storage: memory (default) or redis (needs REDIS_URL)
STORE=memory
REDIS_URL=redis://127.0.0.1:6379

# AI generation: auto = Anthropic if ANTHROPIC_API_KEY is set, otherwise the offline rule-based generator
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=30000

# Protect the management API (/api/*) when the server is reachable by other people. Mock endpoints stay open.
ADMIN_TOKEN=

# Limits
MAX_BODY_BYTES=100000
MAX_PROJECTS=50
MAX_ENDPOINTS=50
MAX_RESOURCES=20
MAX_SEED_COUNT=200
MAX_RECORDS_PER_RESOURCE=5000
MAX_PAGE_SIZE=100
DEFAULT_TTL_MINUTES=0
GENERATE_RATE_PER_MINUTE=10
MOCK_RATE_PER_MINUTE=1200
LOG_LEVEL=info
