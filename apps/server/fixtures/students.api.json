{
  "name": "Student Management API",
  "description": "Manage students and their departments with pagination and department filtering.",
  "version": "1.0.0",
  "apiType": "REST",
  "basePath": "/api",
  "seed": 7,
  "resources": {
    "students": {
      "idPrefix": "stu",
      "seedCount": 24,
      "fields": {
        "name": {
          "type": "string",
          "required": true,
          "faker": "person.fullName",
          "minLength": 2,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "required": true,
          "format": "email"
        },
        "department": {
          "type": "string",
          "required": true,
          "enum": [
            "Computer Science",
            "Information Technology",
            "Mechanical",
            "Electronics",
            "Civil"
          ]
        },
        "year": {
          "type": "integer",
          "required": true,
          "min": 1,
          "max": 4
        }
      },
      "filterable": [
        "department",
        "year"
      ],
      "sortable": [
        "name",
        "year"
      ]
    }
  },
  "endpoints": [
    {
      "id": "list-students",
      "method": "GET",
      "path": "/students",
      "behavior": "list",
      "resource": "students",
      "summary": "List students"
    },
    {
      "id": "get-student",
      "method": "GET",
      "path": "/students/:id",
      "behavior": "getById",
      "resource": "students",
      "summary": "Get one student"
    },
    {
      "id": "create-student",
      "method": "POST",
      "path": "/students",
      "behavior": "create",
      "resource": "students",
      "summary": "Create a student"
    },
    {
      "id": "update-student",
      "method": "PATCH",
      "path": "/students/:id",
      "behavior": "update",
      "resource": "students",
      "summary": "Update a student"
    },
    {
      "id": "delete-student",
      "method": "DELETE",
      "path": "/students/:id",
      "behavior": "delete",
      "resource": "students",
      "summary": "Delete a student"
    }
  ]
}